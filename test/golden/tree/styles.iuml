' Общая тема демо-проекта.
' Подключается после stdlib-инклюда C4 относительным путём:
'   !include styles.iuml      — из диаграммы в корне src
'   !include ../styles.iuml   — из вложенной папки

skinparam shadowing false
skinparam roundCorner 8

UpdateElementStyle("person", $bgColor="#0b4884", $fontColor="#ffffff", $borderColor="#052e56")
UpdateElementStyle("system", $bgColor="#1168bd", $fontColor="#ffffff", $borderColor="#0b4884")
UpdateElementStyle("container", $bgColor="#438dd5", $fontColor="#ffffff", $borderColor="#2e6295")
