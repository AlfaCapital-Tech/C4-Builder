{
  "name": "@alfacapital-tech/c4builder",
  "version": "0.2.25",
  "description": "A CLI tool designed to compile a folder structure of markdowns and plant uml files into a site, single file markdown or a collection of markdowns with links",
  "main": "index.js",
  "bin": {
    "c4builder": "./index.js"
  },
  "files": [
    "index.js",
    "cli*.js",
    "build.js",
    "utils.js",
    "defaults.js",
    "d2renderer.js",
    "pngraster.js",
    "jre.js",
    "docsify.template.js",
    "template/",
    "vendor/",
    "README.MD",
    "license"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "homepage": "https://github.com/AlfaCapital-Tech/C4-Builder",
  "bugs": {
    "url": "https://github.com/AlfaCapital-Tech/C4-Builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlfaCapital-Tech/C4-Builder.git"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "test": "vitest run",
    "test:golden": "vitest run test/golden.test.mjs",
    "test:golden:update": "UPDATE_GOLDEN=1 vitest run test/golden.test.mjs"
  },
  "keywords": [
    "C4",
    "C4Model",
    "PlantUML",
    "Markdown",
    "Documentation",
    "Software Architecture",
    "Generator"
  ],
  "author": "Adrian Victor Lupu",
  "contributors": [
    "Alfa Capital Technologies <https://alfacapital.tech>"
  ],
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "chalk": "^2.4.1",
    "commander": "^14.0.0",
    "configstore": "^4.0.0",
    "express": "^4.17.1",
    "figlet": "^1.2.1",
    "fs-extra": "^11.3.4",
    "inquirer": "^8.2.2",
    "joi": "^17.12.2",
    "node-watch": "^0.7.4",
    "open": "^8.4.2",
    "tar": "7.5.19",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@terrastruct/d2": "0.1.33"
  }
}
